<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.monitor.backend.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.monitor.backend.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="role" property="role"/>
        <result column="enabled" property="enabled"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, username, password_hash, role, enabled, create_time, update_time
    </sql>

    <select id="findByUsername" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_user
        WHERE username = #{username}
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_user
        WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user(username, password_hash, role, enabled, create_time, update_time)
        VALUES(#{username}, #{passwordHash}, #{role}, #{enabled}, NOW(), NOW())
    </insert>

    <update id="update">
        UPDATE sys_user
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="role != null">role = #{role},</if>
            <if test="enabled != null">enabled = #{enabled},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <update id="updatePassword">
        UPDATE sys_user
        SET password_hash = #{passwordHash}, update_time = NOW()
        WHERE id = #{id}
    </update>
    
    <select id="findByPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_user
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{offset}, #{size}
    </select>
    
    <select id="countByUsername" resultType="int">
        SELECT COUNT(*)
        FROM sys_user
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
        </where>
    </select>
    
    <delete id="deleteById">
        DELETE FROM sys_user WHERE id = #{id}
    </delete>
    
    <update id="updateEnabled">
        UPDATE sys_user
        SET enabled = #{enabled}, update_time = NOW()
        WHERE id = #{id}
    </update>

</mapper>
