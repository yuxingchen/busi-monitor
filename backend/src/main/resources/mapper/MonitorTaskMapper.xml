<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.monitor.backend.mapper.MonitorTaskMapper">
    <resultMap id="BaseResultMap" type="com.monitor.backend.entity.MonitorTask">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="datasource_id" property="datasourceId"/>
        <result column="sql_script" property="sqlScript"/>
        <result column="cron_expression" property="cronExpression"/>
        <result column="is_active" property="isActive"/>
        <result column="result_type" property="resultType"/>
        <result column="alarm_threshold_rule" property="alarmThresholdRule"/>
        <result column="chart_config" property="chartConfig"/>
        <result column="is_store_data" property="isStoreData"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,
        name,
        datasource_id,
        sql_script,
        cron_expression,
        is_active,
        result_type,
        alarm_threshold_rule,
        chart_config,
        is_store_data,
        create_time,
        update_time
    </sql>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM monitor_task
    </select>

    <select id="findAllActive" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM monitor_task
        WHERE is_active = 1
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM monitor_task
        WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO monitor_task(name, datasource_id, sql_script, cron_expression, is_active, result_type,
                                 alarm_threshold_rule, chart_config, is_store_data, create_time, update_time)
        VALUES (#{name}, #{datasourceId}, #{sqlScript}, #{cronExpression}, #{isActive}, #{resultType},
                #{alarmThresholdRule}, #{chartConfig}, #{isStoreData}, #{createTime}, #{updateTime})
    </insert>

    <update id="update">
        UPDATE monitor_task
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="datasourceId != null">datasource_id = #{datasourceId},</if>
            <if test="sqlScript != null">sql_script = #{sqlScript},</if>
            <if test="cronExpression != null">cron_expression = #{cronExpression},</if>
            <if test="isActive != null">is_active = #{isActive},</if>
            <if test="resultType != null">result_type = #{resultType},</if>
            <if test="alarmThresholdRule != null">alarm_threshold_rule = #{alarmThresholdRule},</if>
            <if test="chartConfig != null">chart_config = #{chartConfig},</if>
            <if test="isStoreData != null">is_store_data = #{isStoreData},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE
        FROM monitor_task
        WHERE id = #{id}
    </delete>
</mapper>
