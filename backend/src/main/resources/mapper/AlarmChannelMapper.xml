<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.monitor.backend.mapper.AlarmChannelMapper">

    <resultMap id="BaseResultMap" type="com.monitor.backend.entity.AlarmChannel">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="type" property="type"/>
        <result column="config" property="config"/>
        <result column="is_active" property="isActive"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, type, config, is_active, create_time, update_time
    </sql>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM alarm_channel
        ORDER BY id DESC
    </select>

    <select id="findAllActive" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM alarm_channel
        WHERE is_active = 1
        ORDER BY id DESC
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM alarm_channel
        WHERE id = #{id}
    </select>

    <select id="findByType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM alarm_channel
        WHERE type = #{type} AND is_active = 1
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO alarm_channel(name, type, config, is_active, create_time, update_time)
        VALUES(#{name}, #{type}, #{config}, #{isActive}, #{createTime}, #{updateTime})
    </insert>

    <update id="update">
        UPDATE alarm_channel
        SET name = #{name}, type = #{type}, config = #{config},
            is_active = #{isActive}, update_time = #{updateTime}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM alarm_channel WHERE id = #{id}
    </delete>

</mapper>
